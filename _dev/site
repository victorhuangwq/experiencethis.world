#!/usr/bin/env bash
set -euo pipefail

project_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
action="${1:-serve}"
case "$action" in
  setup|build|check|serve) ;;
  *) echo "Usage: bash _dev/site [setup|build|check|serve]" >&2; exit 2 ;;
esac

# Use this environment's Docker daemon and retain its proxy configuration.
docker_local() {
  env -u DOCKER_HOST -u DOCKER_CONTEXT -u DOCKER_TLS \
    -u DOCKER_TLS_VERIFY -u DOCKER_CERT_PATH \
    docker --host=unix:///var/run/docker.sock "$@"
}

args=(--rm --init --user "$(id -u):$(id -g)"
  --mount "type=bind,src=$project_dir,dst=/site"
  --workdir /site
  -e HOME=/tmp
  -e GEM_HOME=/site/vendor/gems
  -e GEM_PATH=/site/vendor/gems:/usr/local/bundle
  -e BUNDLE_PATH=/site/vendor/bundle
  -e BUNDLE_FORCE_RUBY_PLATFORM=true
  -e BUNDLE_APP_CONFIG=/site/vendor/bundle-config
  -e JEKYLL_ENV=development)

# Ruby replaces its default trust store with SSL_CERT_FILE, so use the full
# host bundle, which includes the managed environment's proxy certificate.
if [[ -f /etc/ssl/certs/ca-certificates.crt ]]; then
  args+=(--mount type=bind,src=/etc/ssl/certs/ca-certificates.crt,dst=/run/host-ca.pem,readonly
    -e SSL_CERT_FILE=/run/host-ca.pem
    -e BUNDLE_SSL_CA_CERT=/run/host-ca.pem)
fi

if [[ "$action" == serve ]]; then
  args+=(-p 127.0.0.1:4000:4000 -p 127.0.0.1:35729:35729)
fi

docker_local run "${args[@]}" ruby:2.7.5 bash -euc '
  bundle_cmd=/site/vendor/gems/bin/bundle
  if [[ "$1" == setup ]]; then
    if ! gem list --installed --exact bundler --version 2.4.22 >/dev/null; then
      gem install bundler -v 2.4.22 --no-document
    fi
    exec "$bundle_cmd" _2.4.22_ install --jobs 4 --retry 3
  fi
  if [[ ! -x "$bundle_cmd" ]]; then
    echo "Run bash _dev/site setup first." >&2
    exit 1
  fi
  if [[ "$1" == build ]]; then
    exec "$bundle_cmd" _2.4.22_ exec jekyll build
  fi
  if [[ "$1" == check ]]; then
    exec "$bundle_cmd" _2.4.22_ exec ruby _dev/check_site.rb
  fi
  exec "$bundle_cmd" _2.4.22_ exec jekyll serve \
    --host 0.0.0.0 --port 4000 --livereload --force_polling
' -- "$action"
